  "Return to the options screen.": "\u0412\u0435\u0440\u043d\u0443\u0442\u044c\u0441\u044f \u0432 \u043c\u0435\u043d\u044e \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043a.",
  "Select the default controller options.": "\u0412\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u0438\u0441\u0445\u043e\u0434\u043d\u044b\u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438.",
  "Turn assisted aiming on or off.": "\u041f\u043e\u043c\u043e\u0449\u044c \u043f\u0440\u0438 \u043d\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u0438 \u043d\u0430 \u0446\u0435\u043b\u044c.",
  "Select inverted or normal pitch mode.": "\u041d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u043d\u0430\u043a\u043b\u043e\u043d\u0430 \u0432\u0437\u0433\u043b\u044f\u0434\u0430.",
  "Turn controller vibration on or off.": "\u0412\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u0438 \u043e\u0442\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u0432\u0438\u0431\u0440\u0430\u0446\u0438\u0438.",
  "Select an analog stick sensitivity preset or create a custom setting.": "\u0413\u043e\u0442\u043e\u0432\u044b\u0439 \u043f\u0440\u043e\u0444\u0438\u043b\u044c \u0438\u043b\u0438 \u0440\u0443\u0447\u043d\u0430\u044f \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430 \u0441\u0442\u0438\u043a\u043e\u0432.",
  "Custom setting selected.": "\u0412\u044b\u0431\u0440\u0430\u043d \u0441\u0432\u043e\u0439 \u043f\u0440\u043e\u0444\u0438\u043b\u044c.",
  "Soldier setting selected.": "\u0412\u044b\u0431\u0440\u0430\u043d \u043f\u0440\u043e\u0444\u0438\u043b\u044c \u0411\u041e\u0415\u0426.",
  "Trainee setting selected.": "\u0412\u044b\u0431\u0440\u0430\u043d \u043f\u0440\u043e\u0444\u0438\u043b\u044c \u041d\u041e\u0412\u0418\u0427\u041e\u041a.",
  "Seal setting selected.": "\u0412\u044b\u0431\u0440\u0430\u043d \u043f\u0440\u043e\u0444\u0438\u043b\u044c \u041f\u0420\u041e\u0424\u0418.",
  "Adjust how fast your SEAL rotates and pitches.": "\u0421\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u0432\u0437\u0433\u043b\u044f\u0434\u0430.",
  "Adjust how quickly your SEAL reaches maximum turn speed.": "\u0420\u0430\u0437\u0433\u043e\u043d \u0434\u043e \u043f\u043e\u043b\u043d\u043e\u0439 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0430.",
  "Adjust the size of the center area where analog stick movement is ignored.": "\u041e\u0442\u043a\u043b\u043e\u043d\u0435\u043d\u0438\u0435 \u0443 \u0446\u0435\u043d\u0442\u0440\u0430 \u0441\u0442\u0438\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043d\u0435 \u0443\u0447\u0438\u0442\u044b\u0432\u0430\u0435\u0442\u0441\u044f.",
  "Press the X button to return to options.": "\u041d\u0430\u0436\u043c\u0438\u0442\u0435 X, \u0447\u0442\u043e\u0431\u044b \u0432\u0435\u0440\u043d\u0443\u0442\u044c\u0441\u044f \u0432 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438.",
  "Press the X button to return to default settings.": "\u041d\u0430\u0436\u043c\u0438\u0442\u0435 X \u0434\u043b\u044f \u0441\u0431\u0440\u043e\u0441\u0430 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043a.",
  "Select an analog motion preset or create a custom configuration.": "\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0433\u043e\u0442\u043e\u0432\u044b\u0439 \u043f\u0440\u043e\u0444\u0438\u043b\u044c \u0441\u0442\u0438\u043a\u043e\u0432 \u0438\u043b\u0438 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u0442\u0435 \u0441\u0432\u043e\u0439.",
  "Adjust left stick sensitivity": "\u0427\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0441\u043b\u0435\u0432\u0430.",
  "Adjust right stick sensitivity": "\u0427\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0441\u043f\u0440\u0430\u0432\u0430.",
  "Adjust left stick acceleration": "\u0423\u0441\u043a\u043e\u0440\u0435\u043d\u0438\u0435 \u043b\u0435\u0432\u043e\u0433\u043e \u0441\u0442\u0438\u043a\u0430.",
  "Adjust right stick acceleration": "\u0423\u0441\u043a\u043e\u0440\u0435\u043d\u0438\u0435 \u043f\u0440\u0430\u0432\u043e\u0433\u043e \u0441\u0442\u0438\u043a\u0430.",
  "Adjust left deadstick mode": "\u041c\u0435\u0440\u0442\u0432\u0430\u044f \u0437\u043e\u043d\u0430 \u043b\u0435\u0432\u043e\u0433\u043e \u0441\u0442\u0438\u043a\u0430.",
  "Adjust right deadstick mode": "\u041c\u0435\u0440\u0442\u0432\u0430\u044f \u0437\u043e\u043d\u0430 \u043f\u0440\u0430\u0432\u043e\u0433\u043e \u0441\u0442\u0438\u043a\u0430."
}
