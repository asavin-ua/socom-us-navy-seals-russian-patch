{
  "VIDEO OPTIONS": "\u041d\u0410\u0421\u0422\u0420\u041e\u0419\u041a\u0418 \u0412\u0418\u0414\u0415\u041e",
  "Adjust the brightness so that everything left of the white line is black.": "\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u0442\u0435 \u044f\u0440\u043a\u043e\u0441\u0442\u044c: \u0441\u043b\u0435\u0432\u0430 \u043e\u0442 \u0431\u0435\u043b\u043e\u0439 \u043b\u0438\u043d\u0438\u0438 \u0432\u0441\u0435 \u0434\u043e\u043b\u0436\u043d\u043e \u0431\u044b\u0442\u044c \u0447\u0435\u0440\u043d\u044b\u043c.",
  "BRIGHTNESS": "\u042f\u0420\u041a\u041e\u0421\u0422\u042c",
  "VIDEO MODE": "\u0420\u0410\u0417\u0412\u0415\u0420\u0422\u041a\u0410",
  "INTERLACED": "480I",
  "PROGRESSIVE SCAN (480p)": "480P",
  "HELP WINDOWS": "\u041f\u041e\u0414\u0421\u041a\u0410\u0417\u041a\u0418",
  "OFF": "\u0412\u042b\u041a\u041b",
  "ON": "\u0412\u041a\u041b",
  "HEAD BOB": "\u041f\u041e\u041a\u0410\u0427\u0418\u0412\u0410\u041d\u0418\u0415",
  "DEFAULT SETTINGS": "\u0421\u0411\u0420\u041e\u0421 \u041d\u0410\u0421\u0422\u0420\u041e\u0415\u041a",
  "RETURN": "\u041d\u0410\u0417\u0410\u0414",
  "Return to the options screen.": "\u0412\u0435\u0440\u043d\u0443\u0442\u044c\u0441\u044f \u043a \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430\u043c.",
  "Turn on or off the first person head bob.": "\u041a\u0430\u0447\u0430\u043d\u0438\u0435 \u043a\u0430\u043c\u0435\u0440\u044b \u043f\u0440\u0438 \u0432\u0438\u0434\u0435 \u043e\u0442 \u043f\u0435\u0440\u0432\u043e\u0433\u043e \u043b\u0438\u0446\u0430.",
  "Select Interlaced or Progressive Scan video mode.": "480I - \u0447\u0435\u0440\u0435\u0437 \u0441\u0442\u0440\u043e\u043a\u0443. 480P - \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u043d\u0430\u044f.",
  "Enable or disable the in-game help windows.": "\u0412\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u0438\u043b\u0438 \u0432\u044b\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u043f\u043e\u0434\u0441\u043a\u0430\u0437\u043a\u0438 \u0432 \u0438\u0433\u0440\u0435.",
  "Select the default video options.": "\u0418\u0441\u0445\u043e\u0434\u043d\u044b\u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0432\u0438\u0434\u0435\u043e.",
  "Progressive Scan (480p) video mode selected. Choose Yes if you would like continue playing in Progressive Scan or No to return to Interlaced video mode.": "\u0412\u043a\u043b\u044e\u0447\u0435\u043d\u0430 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u043d\u0430\u044f \u0440\u0430\u0437\u0432\u0435\u0440\u0442\u043a\u0430 (480P). \u0414\u0410 - \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u0440\u0435\u0436\u0438\u043c. \u041d\u0415\u0422 - \u0432\u0435\u0440\u043d\u0443\u0442\u044c \u0447\u0435\u0440\u0435\u0441\u0441\u0442\u0440\u043e\u0447\u043d\u0443\u044e \u0440\u0430\u0437\u0432\u0435\u0440\u0442\u043a\u0443.",
  "No": "\u041d\u0415\u0422",
  "Yes": "\u0414\u0410",
  "Returned to Interlaced video mode. Press the X button to continue.": "\u0427\u0435\u0440\u0435\u0441\u0441\u0442\u0440\u043e\u0447\u043d\u0430\u044f \u0440\u0430\u0437\u0432\u0435\u0440\u0442\u043a\u0430. \u041d\u0430\u0436\u043c\u0438\u0442\u0435 X \u0434\u043b\u044f \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0435\u043d\u0438\u044f.",
  "Continue": "\u0414\u0410\u041b\u0415\u0415",
  "Interlaced video mode restored. Press the X button to continue.": "\u0412\u043e\u0437\u0432\u0440\u0430\u0442 \u043a \u0447\u0435\u0440\u0435\u0441\u0441\u0442\u0440\u043e\u0447\u043d\u043e\u0439 \u0440\u0430\u0437\u0432\u0435\u0440\u0442\u043a\u0435. \u041d\u0430\u0436\u043c\u0438\u0442\u0435 X."
}
