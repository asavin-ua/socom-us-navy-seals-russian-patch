    [
      "LASER DESIGNATOR",
      "\u041b\u0410\u0417\u0415\u0420\u041d\u042b\u0419 \u0426\u0415\u041b\u0415\u0423\u041a\u0410\u0417\u0410\u0422\u0415\u041b\u042c",
